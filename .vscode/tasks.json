{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build APP",
            "type": "shell",
            "command": "cmake --build roto-sales-chassis-app/build",
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Build BOOT",
            "type": "shell",
            "command": "cmake --build roto-sales-chassis-boot/build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash ST-Link (BOOT)",
            "type": "shell",
            "command": "E:/tools/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32g4x.cfg",
                "-f", "flash_boot.cfg"
            ],
            "options": {
                "env": {
                    "OPENOCD_SCRIPTS": "E:/tools/OpenOCD-20260302-0.12.0/share/openocd/scripts"
                },
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash ST-Link (APP)",
            "type": "shell",
            "command": "E:/tools/OpenOCD-20260302-0.12.0/bin/openocd.exe",
            "args": [
                "-f", "interface/stlink.cfg",
                "-f", "target/stm32g4x.cfg",
                "-f", "flash_app.cfg"
            ],
            "options": {
                "env": {
                    "OPENOCD_SCRIPTS": "E:/tools/OpenOCD-20260302-0.12.0/share/openocd/scripts"
                },
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}